# Which LLM to use: gemini (free tier via Google AI Studio) or grok (xAI, OpenAI-compatible API)
LLM_PROVIDER=gemini

# Gemini: create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check AI Studio for the current free-tier model names; override here if this one changes.
GEMINI_MODEL=gemini-2.5-flash

# Grok (optional): needs an xAI API key. Check xAI docs for current model names.
XAI_API_KEY=
GROK_MODEL=grok-4-fast

# Web search (also used for Reddit via a domain filter): free tier at https://tavily.com
TAVILY_API_KEY=

# Free tiers are rate limited. Requests per minute the app will allow itself.
LLM_RPM=8
# Hard cap on LLM calls per run (cost / runaway-loop guardrail). A full run uses roughly 30-40.
MAX_LLM_CALLS=120

# Opinions track (Hacker News + Reddit). Set to 0 for a facts-only run.
ENABLE_COMMUNITY=1
# Sentiment scorer: hf (local Hugging Face model; needs `pip install -r requirements-ml.txt`) or llm.
# If hf is chosen but not installed, the app falls back to llm automatically.
SENTIMENT_BACKEND=hf
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# App Store storefront for the App Store agent (auto-runs only when the planner sees apps; see --apps / --no-apps).
APP_COUNTRY=us
